{
  "name": "tracegrove",
  "version": "0.4.0",
  "private": false,
  "description": "End-to-end tests that check what your app actually did: APIs, web UIs, voice agents and chatbots, with independent readbacks and verifiable evidence.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "bin": {
    "tracegrove": "./dist/cli/main.js",
    "workflow-verify": "./dist/cli/main.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./imports": {
      "types": "./dist/imports/index.d.ts",
      "default": "./dist/imports/index.js"
    },
    "./integrations/awr": {
      "types": "./dist/integrations/awr/index.d.ts",
      "default": "./dist/integrations/awr/index.js"
    },
    "./authoring": {
      "types": "./dist/authoring/index.d.ts",
      "default": "./dist/authoring/index.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "default": "./dist/protocol/index.js"
    },
    "./coordination": {
      "types": "./dist/core/coordination.d.ts",
      "default": "./dist/core/coordination.js"
    }
  },
  "files": [
    "dist",
    "schema",
    "samples",
    "docs/getting-started.md",
    "docs/agent-guide.md",
    "docs/extending.md",
    "ROADMAP.md",
    "docs/local-execution-recovery.md",
    "docs/verified-bundles.md",
    "docs/browser-driver.md",
    "docs/native-jobs.md",
    "docs/mcp-driver.md",
    "docs/images/notes-run.png",
    "docs/images/notes-run-mobile.png",
    "LICENSE",
    "README.md",
    "docs/result-sink.md",
    "docs/replay-comparison.md",
    "docs/attempt-usage.md",
    "docs/attempt-inventory.md",
    "docs/native-observation-import.md",
    "docs/workflow-knowledge.md",
    "docs/persona-pools.md",
    "docs/benchmark-evidence.md",
    "docs/git-object-proof.md",
    "docs/voice-and-chat.md",
    "docs/stand-ins.md",
    "docs/signed-evidence.md",
    "docs/security.md",
    "docs/readiness-and-handoff.md",
    "docs/environments.md",
    "docs/images/readiness.png",
    "docs/images/voice-run.png",
    "SECURITY.md",
    "docs/images/try-voice.png",
    "docs/images/try-bug-caught.png",
    "docs/pr-proof-card.md"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json && node scripts/copy-samples.mjs",
    "typecheck": "tsc --project tsconfig.json --noEmit && tsc --project tsconfig.container.json --noEmit",
    "test": "vitest run",
    "test:conformance": "vitest run conformance/",
    "test:django": "vitest run --config vitest.django.config.ts",
    "test:dogfood": "npm run build && node dist/cli/main.js test --config dogfood/tracegrove.config.yaml",
    "test:container": "node scripts/container-conformance.mjs",
    "schema:export": "node --import tsx scripts/export-schemas.ts",
    "schema:check": "node --import tsx scripts/export-schemas.ts --check && node --import tsx scripts/export-environment-examples.ts --check",
    "test:onboarding": "node scripts/readme-onboarding.mjs",
    "verify": "npm run typecheck && npm run schema:check && npm run test"
  },
  "dependencies": {
    "playwright": "1.64.1",
    "saxes": "6.0.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@useorgx/agent-work-receipt": "0.3.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "@useorgx/agent-work-receipt": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@useorgx/agent-work-receipt": "0.3.0",
    "@types/node": "22.19.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "keywords": [
    "testing",
    "workflow",
    "verification",
    "cli",
    "evidence",
    "end-to-end",
    "e2e",
    "voice-agent",
    "chatbot",
    "pipecat",
    "mcp"
  ],
  "homepage": "https://github.com/hopeatina/tracegrove#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hopeatina/tracegrove.git"
  },
  "bugs": {
    "url": "https://github.com/hopeatina/tracegrove/issues"
  }
}
