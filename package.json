{
  "name": "workflow-verify",
  "version": "0.2.0",
  "private": true,
  "description": "tracegrove: behaviour tests against your real app, drafted by Claude Code or Codex, sealed as re-verifiable evidence.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": { "node": ">=22.22.0 <23" },
  "bin": { "tracegrove": "./dist/cli/main.js", "workflow-verify": "./dist/cli/main.js" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./integrations/awr": { "types": "./dist/integrations/awr/index.d.ts", "default": "./dist/integrations/awr/index.js" },
    "./authoring": { "types": "./dist/authoring/index.d.ts", "default": "./dist/authoring/index.js" },
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./protocol": { "types": "./dist/protocol/index.d.ts", "default": "./dist/protocol/index.js" },
    "./coordination": { "types": "./dist/core/coordination.d.ts", "default": "./dist/core/coordination.js" }
  },
  "files": ["dist", "schema", "samples", "docs/cleanup-followups.md", "docs/source-review.md", "docs/git-source-resolution.md", "docs/local-review-store.md", "docs/qualification-registration.md", "docs/qualification-results.md", "docs/replay-assessment.md", "docs/scenario-activation.md", "docs/verified-bundles.md", "docs/developer-ux.md", "docs/architecture.md", "docs/browser-driver.md", "docs/native-jobs.md", "docs/result-sink.md", "docs/awr-delivery.md", "docs/work-report-attachment.md", "conformance/coordination-vectors.json", "LICENSE", "README.md", "docs/images/ui-run.png"],
  "scripts": {
    "build": "tsc --project tsconfig.build.json && node scripts/copy-samples.mjs",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run",
    "test:conformance": "vitest run conformance/",
    "test:django": "vitest run --config vitest.django.config.ts",
    "test:container": "node scripts/container-conformance.mjs",
    "schema:export": "node --import tsx scripts/export-schemas.ts",
    "schema:check": "node --import tsx scripts/export-schemas.ts --check",
    "verify": "npm run typecheck && npm run schema:check && npm run test"
  },
  "dependencies": {
    "playwright": "1.64.1",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "peerDependencies": { "@useorgx/agent-work-receipt": "0.3.0" },
  "peerDependenciesMeta": { "@useorgx/agent-work-receipt": { "optional": true } },
  "devDependencies": {
    "@useorgx/agent-work-receipt": "0.3.0",
    "@types/node": "22.19.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
