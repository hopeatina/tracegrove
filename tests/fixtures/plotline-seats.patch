diff --git a/jobs/seat-audit.mjs b/jobs/seat-audit.mjs
new file mode 100644
index 0000000..21c2f2b
--- /dev/null
+++ b/jobs/seat-audit.mjs
@@ -0,0 +1,16 @@
+// Nightly: compare each account's members with its paid seats and email the owner when over.
+import cron from 'node-cron';
+import Stripe from 'stripe';
+import { readdirSync, readFileSync, writeFileSync } from 'node:fs';
+import { overSeats } from '../lib/seats.mjs';
+
+const stripe = new Stripe(process.env.STRIPE_SECRET_KEY ?? '');
+cron.schedule('0 3 * * *', async () => {
+  for (const f of readdirSync(process.env.BILLING_DATA_DIR ?? './billing-data')) {
+    const account = JSON.parse(readFileSync(f, 'utf8'));
+    const members = (await stripe.subscriptions.list({ customer: account.id })).data.length;
+    const over = overSeats(account, members);
+    if (over > 0) await fetch(`${process.env.EMAIL_URL}/send`, { method: 'POST', body: JSON.stringify({ to: account.id, template: 'over_seats', over }) });
+    writeFileSync(`${f}.audit`, JSON.stringify({ over, at: Date.now() }));
+  }
+});
diff --git a/lib/seats.mjs b/lib/seats.mjs
new file mode 100644
index 0000000..bcecb02
--- /dev/null
+++ b/lib/seats.mjs
@@ -0,0 +1,14 @@
+// Seat pricing: each seat on a plan has a monthly price; changing seats mid-cycle is prorated.
+export const SEAT_PRICE = { starter: 0, team: 900, business: 2900 };
+
+/** The prorated charge for moving from `from` to `to` seats with `daysLeft` days left in the cycle. */
+export function prorate(plan, from, to, daysLeft, daysInCycle = 30) {
+  if (!Number.isInteger(to) || to < 1 || to > 500) throw new RangeError('seats must be 1-500');
+  const delta = to - from;
+  return Math.round(delta * SEAT_PRICE[plan] * (daysLeft / daysInCycle));
+}
+
+/** Members beyond the paid seats, for the nightly audit. */
+export function overSeats(account, members) {
+  return Math.max(0, members - (account.seats ?? 1));
+}
