diff --git a/web/components/SeatsPanel.jsx b/web/components/SeatsPanel.jsx
new file mode 100644
index 0000000..5325dfd
--- /dev/null
+++ b/web/components/SeatsPanel.jsx
@@ -0,0 +1,24 @@
+import { useEffect, useState } from 'react';
+
+/** The billing page's seat control: shows paid seats and lets an owner add or remove them. */
+export function SeatsPanel({ token }) {
+  const headers = { authorization: `Bearer ${token}`, 'content-type': 'application/json' };
+  const [seats, setSeats] = useState(null);
+  const [error, setError] = useState(null);
+  useEffect(() => { fetch('/seats', { headers }).then((r) => r.json()).then((d) => setSeats(d.seats)); }, []);
+  async function change(next) {
+    const r = await fetch('/seats', { method: 'POST', headers, body: JSON.stringify({ seats: next }) });
+    const d = await r.json();
+    if (!r.ok) return setError(d.error === 'payment_failed' ? 'Your card was declined.' : 'Choose between 1 and 500 seats.');
+    setError(null); setSeats(d.seats);
+  }
+  if (seats === null) return <p>Loading seats…</p>;
+  return (
+    <section aria-label="Seats">
+      <h2>{seats} seats</h2>
+      <button onClick={() => change(seats + 1)}>Add a seat</button>
+      <button onClick={() => change(seats - 1)} disabled={seats <= 1}>Remove a seat</button>
+      {error && <p role="alert">{error}</p>}
+    </section>
+  );
+}
-- 
