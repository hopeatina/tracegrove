{
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "maxLength": 64000,
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "items": {
            "$ref": "#/$defs/__schema0"
          },
          "maxItems": 5000,
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          },
          "propertyNames": {
            "maxLength": 200,
            "type": "string"
          },
          "type": "object"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attempts": {
      "maximum": 2147483647,
      "minimum": 0,
      "type": "integer"
    },
    "calls": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "at": {
            "type": "string"
          },
          "faulted": {
            "type": "boolean"
          },
          "json": {
            "anyOf": [
              {
                "$ref": "#/$defs/__schema0"
              },
              {
                "type": "null"
              }
            ]
          },
          "method": {
            "maxLength": 16,
            "type": "string"
          },
          "path": {
            "maxLength": 2048,
            "type": "string"
          },
          "query": {
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          },
          "status": {
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
          },
          "text": {
            "anyOf": [
              {
                "maxLength": 65536,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "method",
          "path",
          "query",
          "json",
          "text",
          "status",
          "faulted",
          "at"
        ],
        "type": "object"
      },
      "maxItems": 200,
      "type": "array"
    },
    "count": {
      "maximum": 2147483647,
      "minimum": 0,
      "type": "integer"
    },
    "kind": {
      "const": "stand_in",
      "type": "string"
    },
    "route": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "method": {
              "enum": [
                "GET",
                "POST",
                "PUT",
                "PATCH",
                "DELETE"
              ],
              "type": "string"
            },
            "path": {
              "maxLength": 512,
              "minLength": 1,
              "pattern": "^\\/[A-Za-z0-9_.~:/{}*-]*$",
              "type": "string"
            }
          },
          "required": [
            "method",
            "path"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "standIn": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_-]*$",
      "type": "string"
    }
  },
  "required": [
    "kind",
    "standIn",
    "route",
    "count",
    "calls",
    "attempts"
  ],
  "type": "object"
}
