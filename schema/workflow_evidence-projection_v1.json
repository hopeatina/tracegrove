          "caseRef": {
            "additionalProperties": false,
            "properties": {
              "digest": {
                "additionalProperties": false,
                "properties": {
                  "algorithm": {
                    "const": "sha256",
                    "type": "string"
                  },
                  "hex": {
                    "pattern": "^[0-9a-f]{64}$",
                    "type": "string"
                  }
                },
                "required": [
                  "algorithm",
                  "hex"
                ],
                "type": "object"
              },
              "id": {
                "maxLength": 200,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
                "type": "string"
              },
              "revision": {
                "maxLength": 64,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
                "type": "string"
