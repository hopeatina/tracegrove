                "maxItems": 32,
                "type": "array"
              },
              "provider": {
                "enum": [
                  "live",
                  "replay",
                  "mocked",
                  "none"
                ],
                "type": "string"
              },
              "runtime": {
                "enum": [
                  "live",
                  "replay",
                  "mocked"
                ],
                "type": "string"
              }
