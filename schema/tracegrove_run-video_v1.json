{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "byteCount": {
      "exclusiveMinimum": 0,
      "maximum": 16777216,
      "type": "integer"
    },
    "digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "mediaType": {
      "const": "video/webm",
      "type": "string"
    }
  },
  "required": [
    "digest",
    "byteCount",
    "mediaType"
  ],
  "type": "object"
}
