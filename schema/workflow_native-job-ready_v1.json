{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "tracegrove.job.ready",
      "type": "string"
    },
    "queues": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
        "type": "string"
      },
      "maxItems": 32,
      "minItems": 1,
      "type": "array"
    },
    "version": {
      "const": 1,
      "type": "number"
    }
  },
  "required": [
    "kind",
    "version",
    "queues"
  ],
  "type": "object"
}
