    "executionId": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
      "type": "string"
    },
    "expiresAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
    },
    "generation": {
      "maximum": 2147483647,
      "minimum": 0,
      "type": "integer"
    },
    "hostPlanRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "additionalProperties": false,
          "properties": {
            "algorithm": {
              "const": "sha256",
              "type": "string"
            },
            "hex": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "algorithm",
            "hex"
          ],
          "type": "object"
        },
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
          "type": "string"
        },
        "revision": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "revision",
        "digest"
      ],
      "type": "object"
    },
    "issuedAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
    },
    "observedRuntimeIdentity": {
      "additionalProperties": false,
      "properties": {
        "arch": {
          "maxLength": 400,
          "minLength": 1,
          "type": "string"
        },
        "node": {
          "maxLength": 400,
          "minLength": 1,
          "type": "string"
        },
        "pid": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "platform": {
          "maxLength": 400,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "node",
        "platform",
        "arch",
        "pid"
      ],
      "type": "object"
    },
    "observedWorkspaceIdentityRef": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "digest": {
              "additionalProperties": false,
              "properties": {
                "algorithm": {
                  "const": "sha256",
