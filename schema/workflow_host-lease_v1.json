            "revision": {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
              "type": "string"
            }
          },
          "required": [
            "id",
            "revision",
            "digest"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    }
