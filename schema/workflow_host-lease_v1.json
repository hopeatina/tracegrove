    "sessionHandleRef": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "digest": {
              "additionalProperties": false,
              "properties": {
                "algorithm": {
                  "const": "sha256",
                  "type": "string"
                },
                "hex": {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                }
              },
              "required": [
