{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "ref": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "additionalProperties": false,
          "properties": {
            "algorithm": {
              "const": "sha256",
              "type": "string"
            },
            "hex": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "algorithm",
            "hex"
          ],
          "type": "object"
        },
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
          "type": "string"
        },
        "revision": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "revision",
        "digest"
      ],
      "type": "object"
    },
    "replayInference": {
      "const": "none",
      "type": "string"
    },
    "schemaVersion": {
      "const": "workflow.intelligence-policy/v1",
      "type": "string"
    },
    "scope": {
      "additionalProperties": false,
      "properties": {
        "ownerId": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
          "type": "string"
        },
        "tenantId": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "visibility": {
          "enum": [
            "public",
            "owner_private",
            "tenant_private"
          ],
          "type": "string"
        }
      },
      "required": [
        "ownerId",
        "tenantId",
        "visibility"
      ],
      "type": "object"
    },
    "stages": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "allowed": {
            "type": "boolean"
          },
          "costCeilingCents": {
            "maximum": 1000000000,
            "minimum": 0,
            "type": "integer"
          },
          "maxCalls": {
            "maximum": 2147483647,
            "minimum": 0,
            "type": "integer"
          },
          "maxTokens": {
            "maximum": 2147483647,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "allowed",
          "maxCalls",
          "maxTokens",
          "costCeilingCents"
        ],
        "type": "object"
      },
      "propertyNames": {
        "enum": [
          "analysis",
          "drafting",
          "discovery",
          "diagnosis",
          "evaluation",
          "benchmark"
        ],
        "type": "string"
      },
      "required": [
        "analysis",
        "drafting",
        "discovery",
        "diagnosis",
        "evaluation",
        "benchmark"
      ],
      "type": "object"
    }
  },
  "required": [
    "schemaVersion",
    "ref",
    "scope",
    "stages",
    "replayInference"
  ],
  "type": "object"
}
