      "items": {
        "maxLength": 200,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
        "type": "string"
      },
      "maxItems": 16,
      "type": "array"
    },
    "cleanupOperations": {
