{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "agent": {
      "additionalProperties": false,
      "description": "Agent settings. .tracegrove/settings.json (written by tracegrove ui) and CLI flags override these per developer.",
      "properties": {
        "maxBudgetUsd": {
          "description": "Spend cap per draft run, passed to Claude Code as --max-budget-usd.",
          "exclusiveMinimum": 0,
          "maximum": 100,
          "type": "number"
        },
        "model": {
          "description": "Explicit model passed to the agent CLI. Defaults: claude-haiku-5-5 for claude; gpt-6-luna for codex.",
          "maxLength": 120,
          "minLength": 1,
          "type": "string"
        },
        "provider": {
          "default": "claude",
          "description": "Coding agent that drafts and repairs flows: claude (Claude Code CLI), codex (Codex CLI) or none.",
          "enum": [
            "claude",
            "codex",
            "none"
          ],
          "type": "string"
        }
      },
      "type": "object"
    },
    "app": {
      "additionalProperties": false,
      "properties": {
        "adapter": {
          "description": "Launch preset: node, fastapi, django or command.",
          "enum": [
            "node",
            "fastapi",
            "django",
            "command"
          ],
          "type": "string"
        },
        "entry": {
          "description": "node: script path; fastapi: module:app; django: folder containing manage.py.",
          "type": "string"
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "Extra env; {port} and {dataDir} are substituted.",
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        },
        "health": {
          "default": "/health",
          "description": "GET path that returns 2xx once the app is ready.",
          "pattern": "^\\/",
          "type": "string"
        },
        "inject": {
          "additionalProperties": false,
          "default": {
            "dataDir": "TRACEGROVE_DATA_DIR",
            "port": "PORT",
            "tokens": "TRACEGROVE_TOKENS"
          },
          "properties": {
            "dataDir": {
              "default": "TRACEGROVE_DATA_DIR",
              "type": "string"
            },
            "port": {
              "default": "PORT",
              "type": "string"
            },
            "tokens": {
              "default": "TRACEGROVE_TOKENS",
              "type": "string"
            }
          },
          "type": "object"
        },
        "nativeJobs": {
          "const": "node_ipc/v1",
          "description": "Opt in to the application-owned native Node job bridge.",
          "type": "string"
        },
        "python": {
          "description": "fastapi/django: interpreter (default .venv/bin/python when present, else python3).",
          "type": "string"
        },
        "readyTimeoutMs": {
          "default": 20000,
          "exclusiveMinimum": 0,
          "maximum": 300000,
          "type": "integer"
        },
        "root": {
          "default": ".",
          "description": "App directory relative to this file; the launch cwd.",
          "type": "string"
        },
        "run": {
          "description": "command adapter: shell command that starts the app on $PORT.",
          "type": "string"
        },
        "sources": {
          "description": "Globs (relative to root) whose bytes are attested as the tested source.",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "adapter"
      ],
      "type": "object"
    },
    "defaults": {
      "additionalProperties": false,
      "default": {
        "caseTimeoutMs": 30000,
        "stepTimeoutMs": 5000
      },
      "properties": {
        "caseTimeoutMs": {
          "default": 30000,
          "exclusiveMinimum": 0,
          "maximum": 600000,
          "type": "integer"
        },
        "stepTimeoutMs": {
          "default": 5000,
          "exclusiveMinimum": 0,
          "maximum": 120000,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "personas": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "inputMode": {
            "enum": [
              "pointer",
              "touch",
              "keyboard"
            ],
            "type": "string"
          },
          "locale": {
            "maxLength": 16,
            "minLength": 2,
            "type": "string"
          },
          "reducedMotion": {
            "type": "boolean"
          },
          "subject": {
            "minLength": 1,
            "type": "string"
          },
          "timezone": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "viewport": {
            "additionalProperties": false,
            "properties": {
              "height": {
                "maximum": 2147483647,
                "minimum": 1,
                "type": "integer"
              },
              "width": {
                "maximum": 2147483647,
                "minimum": 1,
                "type": "integer"
              }
            },
            "required": [
              "width",
              "height"
            ],
            "type": "object"
          }
        },
        "required": [
          "subject"
        ],
        "type": "object"
      },
      "description": "Callers. The first one is the default `as:` for every step.",
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
        "type": "string"
      },
      "type": "object"
    },
    "project": {
      "description": "Short project name, shown in reports and run summaries.",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
      "type": "string"
    },
    "testDir": {
      "default": "tracegrove",
      "description": "Folder holding *.flow.yaml and fixtures/, relative to this file.",
      "type": "string"
    }
  },
  "required": [
    "project",
    "app",
    "personas"
  ],
  "type": "object"
}
