{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority": {
      "const": "none",
      "type": "string"
    },
    "basis": {
      "const": "supplied_snapshot",
      "type": "string"
    },
    "budgetCents": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "coordinationVersion": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "leaseTime": {
      "const": "not_evaluated",
      "type": "string"
    },
    "pools": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "environmentRef": {
            "additionalProperties": false,
            "properties": {
              "digest": {
                "additionalProperties": false,
                "properties": {
                  "algorithm": {
                    "const": "sha256",
                    "type": "string"
                  },
                  "hex": {
                    "pattern": "^[0-9a-f]{64}$",
                    "type": "string"
                  }
                },
                "required": [
                  "algorithm",
                  "hex"
                ],
                "type": "object"
              },
              "id": {
                "maxLength": 200,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
                "type": "string"
              },
              "revision": {
                "maxLength": 64,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
                "type": "string"
              }
            },
            "required": [
              "id",
              "revision",
              "digest"
            ],
            "type": "object"
          },
          "maxConcurrent": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "maxPerWorker": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "members": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "personaId": {
                  "maxLength": 200,
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
                  "type": "string"
                },
                "state": {
                  "enum": [
                    "unreleased_in_snapshot",
                    "available_in_snapshot"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "personaId",
                "state"
              ],
              "type": "object"
            },
            "maxItems": 1000,
            "type": "array"
          },
          "personaRef": {
            "additionalProperties": false,
            "properties": {
              "digest": {
                "additionalProperties": false,
                "properties": {
                  "algorithm": {
                    "const": "sha256",
                    "type": "string"
                  },
                  "hex": {
                    "pattern": "^[0-9a-f]{64}$",
                    "type": "string"
                  }
                },
                "required": [
                  "algorithm",
                  "hex"
                ],
                "type": "object"
              },
              "id": {
                "maxLength": 200,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
                "type": "string"
              },
              "revision": {
                "maxLength": 64,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
                "type": "string"
              }
            },
            "required": [
              "id",
              "revision",
              "digest"
            ],
            "type": "object"
          },
          "poolRef": {
            "additionalProperties": false,
            "properties": {
              "digest": {
                "additionalProperties": false,
                "properties": {
                  "algorithm": {
                    "const": "sha256",
                    "type": "string"
                  },
                  "hex": {
                    "pattern": "^[0-9a-f]{64}$",
                    "type": "string"
                  }
                },
                "required": [
                  "algorithm",
                  "hex"
                ],
                "type": "object"
              },
              "id": {
                "maxLength": 200,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
                "type": "string"
              },
              "revision": {
                "maxLength": 64,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
                "type": "string"
              }
            },
            "required": [
              "id",
              "revision",
              "digest"
            ],
            "type": "object"
          },
          "unreleased": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "poolRef",
          "personaRef",
          "environmentRef",
          "maxConcurrent",
          "maxPerWorker",
          "unreleased",
          "members"
        ],
        "type": "object"
      },
      "maxItems": 100,
      "type": "array"
    },
    "remainingReservationCents": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "reservedCents": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "schemaVersion": {
      "const": "tracegrove.persona-pool-status/v1",
      "type": "string"
    },
    "scopeId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "scopeId",
    "coordinationVersion",
    "basis",
    "authority",
    "leaseTime",
    "budgetCents",
    "reservedCents",
    "remainingReservationCents",
    "pools"
  ],
  "type": "object"
}
