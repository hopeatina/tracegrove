{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "algorithm": {
      "const": "ed25519",
      "type": "string"
    },
    "followup": {
      "additionalProperties": false,
      "properties": {
        "attemptId": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "coordinationVersion": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "evidence": {
          "items": {
            "oneOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "entityKey": {
                    "maxLength": 256,
                    "minLength": 1,
                    "type": "string"
                  },
                  "kind": {
                    "const": "http_absence",
                    "type": "string"
                  },
                  "method": {
                    "enum": [
                      "GET",
                      "HEAD"
                    ],
                    "type": "string"
                  },
                  "receiptDigest": {
                    "pattern": "^sha256:[a-f0-9]{64}$",
                    "type": "string"
                  },
                  "status": {
                    "anyOf": [
                      {
                        "const": 404,
                        "type": "number"
                      },
                      {
                        "const": 410,
                        "type": "number"
                      }
                    ]
                  }
                },
                "required": [
                  "kind",
                  "entityKey",
                  "receiptDigest",
                  "method",
                  "status"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "entityKey": {
                    "maxLength": 256,
                    "minLength": 1,
                    "type": "string"
                  },
                  "kind": {
                    "const": "host_stop",
                    "type": "string"
                  },
                  "receiptDigest": {
                    "pattern": "^sha256:[a-f0-9]{64}$",
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "entityKey",
                  "receiptDigest"
                ],
                "type": "object"
              }
            ]
          },
          "maxItems": 1000,
          "type": "array"
        },
        "expectationDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "expiresAt": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "generation": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "observedAt": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "observerId": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "schemaVersion": {
          "const": "workflow.cleanup-followup/v1",
          "type": "string"
        },
        "scopeId": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "workerId": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "schemaVersion",
        "scopeId",
        "attemptId",
        "workerId",
        "generation",
        "coordinationVersion",
        "observerId",
        "expectationDigest",
        "observedAt",
        "expiresAt",
        "evidence"
      ],
      "type": "object"
    },
    "keyId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "schemaVersion": {
      "const": "workflow.signed-cleanup-followup/v1",
      "type": "string"
    },
    "signature": {
      "pattern": "^[A-Za-z0-9_-]{85}[AQgw]$",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "algorithm",
    "keyId",
    "followup",
    "signature"
  ],
  "type": "object"
}
