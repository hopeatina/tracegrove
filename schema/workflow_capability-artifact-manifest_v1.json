      "required": [
        "campaignId",
        "executionId",
        "attemptId",
        "generation",
        "requestRef",
        "sourceSelectionRef",
        "caseRef",
        "personaRef",
        "targetRef",
        "environmentRef",
        "scope"
      ],
      "type": "object"
    },
    "publication": {
      "enum": [
        "incomplete",
        "committed"
      ],
      "type": "string"
    },
    "schemaVersion": {
      "const": "workflow.capability-artifact-manifest/v1",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "binding",
    "publication",
    "artifacts"
  ],
  "type": "object"
}
