{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "campaignId": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
      "type": "string"
    },
    "cellReceiptRefs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "receiptRef": {
            "additionalProperties": false,
            "properties": {
              "digest": {
                "additionalProperties": false,
                "properties": {
                  "algorithm": {
                    "const": "sha256",
                    "type": "string"
                  },
                  "hex": {
                    "pattern": "^[0-9a-f]{64}$",
                    "type": "string"
                  }
                },
                "required": [
                  "algorithm",
                  "hex"
                ],
                "type": "object"
              },
              "id": {
                "maxLength": 200,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
                "type": "string"
              },
              "revision": {
                "maxLength": 64,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
                "type": "string"
              }
            },
            "required": [
              "id",
              "revision",
              "digest"
            ],
            "type": "object"
          },
          "selectionCellId": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
            "type": "string"
          }
        },
        "required": [
          "selectionCellId",
          "receiptRef"
        ],
        "type": "object"
      },
      "maxItems": 500,
      "type": "array"
    },
    "coverage": {
      "additionalProperties": false,
      "properties": {
        "attempted": {
          "maximum": 2147483647,
          "minimum": 0,
          "type": "integer"
        },
        "blocked": {
          "maximum": 2147483647,
          "minimum": 0,
          "type": "integer"
        },
        "completedSteps": {
          "maximum": 2147483647,
          "minimum": 0,
          "type": "integer"
        },
        "excluded": {
          "maximum": 2147483647,
          "minimum": 0,
          "type": "integer"
        },
        "expectedSteps": {
          "maximum": 2147483647,
          "minimum": 0,
          "type": "integer"
        },
        "observed": {
          "maximum": 2147483647,
          "minimum": 0,
          "type": "integer"
        },
        "passed": {
          "maximum": 2147483647,
          "minimum": 0,
          "type": "integer"
        },
        "passedRequiredAssertions": {
          "maximum": 2147483647,
          "minimum": 0,
          "type": "integer"
        },
        "required": {
          "maximum": 2147483647,
          "minimum": 0,
          "type": "integer"
        },
        "requiredAssertions": {
          "maximum": 2147483647,
          "minimum": 0,
          "type": "integer"
        },
        "requiredCells": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "outcome": {
                "maxLength": 400,
                "minLength": 1,
                "type": "string"
              },
              "selectionCellId": {
                "maxLength": 200,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
                "type": "string"
              }
            },
            "required": [
              "selectionCellId",
              "outcome"
            ],
            "type": "object"
          },
          "maxItems": 500,
          "type": "array"
        },
        "selected": {
          "maximum": 2147483647,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "selected",
        "required",
        "attempted",
        "observed",
        "passed",
        "blocked",
        "excluded",
        "requiredCells",
        "expectedSteps",
        "completedSteps",
        "requiredAssertions",
        "passedRequiredAssertions"
      ],
      "type": "object"
    },
    "finalizedAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
    },
    "missingCellIds": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
        "type": "string"
      },
      "maxItems": 500,
      "type": "array"
    },
    "outcome": {
      "enum": [
        "passed",
        "assertion_failed",
        "blocked",
        "infrastructure_failed",
        "inconclusive",
        "cancelled"
      ],
      "type": "string"
    },
    "proofEligible": {
      "type": "boolean"
    },
    "ref": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "additionalProperties": false,
          "properties": {
            "algorithm": {
              "const": "sha256",
              "type": "string"
            },
            "hex": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "algorithm",
            "hex"
          ],
          "type": "object"
        },
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
          "type": "string"
        },
        "revision": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "revision",
        "digest"
      ],
      "type": "object"
    },
    "requestRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "additionalProperties": false,
          "properties": {
            "algorithm": {
              "const": "sha256",
              "type": "string"
            },
            "hex": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "algorithm",
            "hex"
          ],
          "type": "object"
        },
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
          "type": "string"
        },
        "revision": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "revision",
        "digest"
      ],
      "type": "object"
    },
    "schemaVersion": {
      "const": "workflow.campaign-result/v1",
      "type": "string"
    },
    "scope": {
      "additionalProperties": false,
      "properties": {
        "ownerId": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
          "type": "string"
        },
        "tenantId": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "visibility": {
          "enum": [
            "public",
            "owner_private",
            "tenant_private"
          ],
          "type": "string"
        }
      },
      "required": [
        "ownerId",
        "tenantId",
        "visibility"
      ],
      "type": "object"
    },
    "selectionManifestRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "additionalProperties": false,
          "properties": {
            "algorithm": {
              "const": "sha256",
              "type": "string"
            },
            "hex": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "algorithm",
            "hex"
          ],
          "type": "object"
        },
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
          "type": "string"
        },
        "revision": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "revision",
        "digest"
      ],
      "type": "object"
    }
  },
  "required": [
    "schemaVersion",
    "ref",
    "scope",
    "campaignId",
    "requestRef",
    "selectionManifestRef",
    "cellReceiptRefs",
    "missingCellIds",
    "coverage",
    "outcome",
    "proofEligible",
    "finalizedAt"
  ],
  "type": "object"
}
