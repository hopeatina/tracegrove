{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "repositories": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "base": {
            "maxLength": 400,
            "minLength": 1,
            "pattern": "^[^-\\x00-\\x1f\\x7f][^\\x00-\\x1f\\x7f]*$",
            "type": "string"
          },
          "head": {
            "maxLength": 400,
            "minLength": 1,
            "pattern": "^[^-\\x00-\\x1f\\x7f][^\\x00-\\x1f\\x7f]*$",
            "type": "string"
          },
          "repositoryRef": {
            "additionalProperties": false,
            "properties": {
              "digest": {
                "additionalProperties": false,
                "properties": {
                  "algorithm": {
                    "const": "sha256",
                    "type": "string"
                  },
                  "hex": {
                    "pattern": "^[0-9a-f]{64}$",
                    "type": "string"
                  }
                },
                "required": [
                  "algorithm",
                  "hex"
                ],
                "type": "object"
              },
              "id": {
                "maxLength": 200,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
                "type": "string"
              },
              "revision": {
                "maxLength": 64,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
                "type": "string"
              }
            },
            "required": [
              "id",
              "revision",
              "digest"
            ],
            "type": "object"
          },
          "root": {
            "maxLength": 8192,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "repositoryRef",
          "root",
          "head",
          "base"
        ],
        "type": "object"
      },
      "maxItems": 32,
      "minItems": 1,
      "type": "array"
    },
    "scope": {
      "additionalProperties": false,
      "properties": {
        "ownerId": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
          "type": "string"
        },
        "tenantId": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "visibility": {
          "enum": [
            "public",
            "owner_private",
            "tenant_private"
          ],
          "type": "string"
        }
      },
      "required": [
        "ownerId",
        "tenantId",
        "visibility"
      ],
      "type": "object"
    }
  },
  "required": [
    "scope",
    "repositories"
  ],
  "type": "object"
}
