{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attemptNumber": {
      "maximum": 2147483647,
      "minimum": 1,
      "type": "integer"
    },
    "effects": {
      "enum": [
        "none",
        "acknowledged",
        "ambiguous"
      ],
      "type": "string"
    },
    "elapsedMs": {
      "maximum": 2592000000,
      "minimum": 0,
      "type": "integer"
    },
    "failure": {
      "enum": [
        "transport",
        "setup",
        "assertion",
        "cancelled",
        "unsupported"
      ],
      "type": "string"
    },
    "idempotency": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "authorityRef": {
              "additionalProperties": false,
              "properties": {
                "digest": {
                  "additionalProperties": false,
                  "properties": {
                    "algorithm": {
                      "const": "sha256",
                      "type": "string"
                    },
                    "hex": {
                      "pattern": "^[0-9a-f]{64}$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "algorithm",
                    "hex"
                  ],
                  "type": "object"
                },
                "id": {
                  "maxLength": 200,
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
                  "type": "string"
                },
                "revision": {
                  "maxLength": 64,
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
                  "type": "string"
                }
              },
              "required": [
                "id",
                "revision",
                "digest"
              ],
              "type": "object"
            },
            "key": {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
              "type": "string"
            },
            "requestDigest": {
              "additionalProperties": false,
              "properties": {
                "algorithm": {
                  "const": "sha256",
                  "type": "string"
                },
                "hex": {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                }
              },
              "required": [
                "algorithm",
                "hex"
              ],
              "type": "object"
            }
          },
          "required": [
            "key",
            "requestDigest",
            "authorityRef"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "mutating": {
      "type": "boolean"
    },
    "priorAttemptRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "additionalProperties": false,
          "properties": {
            "algorithm": {
              "const": "sha256",
              "type": "string"
            },
            "hex": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "algorithm",
            "hex"
          ],
          "type": "object"
        },
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
          "type": "string"
        },
        "revision": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "revision",
        "digest"
      ],
      "type": "object"
    },
    "remainingDeadlineMs": {
      "maximum": 2592000000,
      "minimum": 0,
      "type": "integer"
    },
    "requestsUsed": {
      "maximum": 2147483647,
      "minimum": 0,
      "type": "integer"
    },
    "retainedArtifactRefs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "digest": {
            "additionalProperties": false,
            "properties": {
              "algorithm": {
                "const": "sha256",
                "type": "string"
              },
              "hex": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              }
            },
            "required": [
              "algorithm",
              "hex"
            ],
            "type": "object"
          },
          "id": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
            "type": "string"
          },
          "revision": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
            "type": "string"
          }
        },
        "required": [
          "id",
          "revision",
          "digest"
        ],
        "type": "object"
      },
      "maxItems": 500,
      "type": "array"
    },
    "retryAfterMs": {
      "anyOf": [
        {
          "maximum": 2592000000,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "attemptNumber",
    "elapsedMs",
    "requestsUsed",
    "remainingDeadlineMs",
    "retryAfterMs",
    "failure",
    "effects",
    "mutating",
    "idempotency",
    "priorAttemptRef",
    "retainedArtifactRefs"
  ],
  "type": "object"
}
