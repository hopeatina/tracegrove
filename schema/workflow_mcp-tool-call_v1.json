{
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "maxLength": 64000,
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "items": {
            "$ref": "#/$defs/__schema0"
          },
          "maxItems": 5000,
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          },
          "propertyNames": {
            "maxLength": 200,
            "type": "string"
          },
          "type": "object"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "arguments": {
      "additionalProperties": {
        "$ref": "#/$defs/__schema0"
      },
      "propertyNames": {
        "maxLength": 128,
        "type": "string"
      },
      "type": "object"
    },
    "endpoint": {
      "maxLength": 512,
      "minLength": 1,
      "pattern": "^\\/(?!\\/)[A-Za-z0-9_./-]*$",
      "type": "string"
    },
    "tool": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.-]+$",
      "type": "string"
    }
  },
  "required": [
    "endpoint",
    "tool",
    "arguments"
  ],
  "type": "object"
}
