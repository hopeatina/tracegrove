{
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "maxLength": 64000,
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "items": {
            "$ref": "#/$defs/__schema0"
          },
          "maxItems": 5000,
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          },
          "propertyNames": {
            "maxLength": 200,
            "type": "string"
          },
          "type": "object"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "componentId": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
      "type": "string"
    },
    "evidence": {
      "additionalProperties": false,
      "properties": {
        "files": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "path": {
                "maxLength": 400,
                "type": "string"
              },
              "sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "type": "object"
          },
          "maxItems": 256,
          "type": "array"
        },
        "observedHealthBody": {
          "anyOf": [
            {
              "$ref": "#/$defs/__schema0"
            },
            {
              "type": "null"
            }
          ]
        },
        "runtimeProbe": {
          "additionalProperties": false,
          "properties": {
            "executable": {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            "executableSha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "family": {
              "enum": [
                "node",
                "python"
              ],
              "type": "string"
            },
            "runtime": {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            "version": {
              "pattern": "^\\d+\\.\\d+\\.\\d+$",
              "type": "string"
            }
          },
          "required": [
            "family",
            "version",
            "runtime",
            "executable",
            "executableSha256"
          ],
          "type": "object"
        }
      },
      "required": [
        "files",
        "observedHealthBody"
      ],
      "type": "object"
    },
    "identity": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "source_digest",
              "type": "string"
            },
            "runtime": {
              "maxLength": 400,
              "minLength": 1,
              "type": "string"
            },
            "sourceDigest": {
              "additionalProperties": false,
              "properties": {
                "algorithm": {
                  "const": "sha256",
                  "type": "string"
                },
                "hex": {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                }
              },
              "required": [
                "algorithm",
                "hex"
              ],
              "type": "object"
            }
          },
          "required": [
            "kind",
            "sourceDigest",
            "runtime"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "declared_release",
              "type": "string"
            },
            "release": {
              "maxLength": 400,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "kind",
            "release"
          ],
          "type": "object"
        }
      ]
    },
    "issuer": {
      "enum": [
        "local_launcher",
        "declared_binding"
      ],
      "type": "string"
    },
    "kind": {
      "enum": [
        "application",
        "service",
        "worker",
        "schema",
        "flag_set",
        "protocol_server",
        "host",
        "widget",
        "mobile_binary",
        "device_runtime",
        "model_endpoint",
        "other"
      ],
      "type": "string"
    },
    "observedAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
    },
    "ref": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "additionalProperties": false,
          "properties": {
            "algorithm": {
              "const": "sha256",
              "type": "string"
            },
            "hex": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "algorithm",
            "hex"
          ],
          "type": "object"
        },
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
          "type": "string"
        },
        "revision": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "revision",
        "digest"
      ],
      "type": "object"
    },
    "schemaVersion": {
      "const": "workflow.identity-attestation/v1",
      "type": "string"
    },
    "scope": {
      "additionalProperties": false,
      "properties": {
        "ownerId": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
          "type": "string"
        },
        "tenantId": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "visibility": {
          "enum": [
            "public",
            "owner_private",
            "tenant_private"
          ],
          "type": "string"
        }
      },
      "required": [
        "ownerId",
        "tenantId",
        "visibility"
      ],
      "type": "object"
    },
    "trustPolicy": {
      "enum": [
        "launcher_computed_source_digest",
        "operator_declared_unverified"
      ],
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "ref",
    "scope",
    "componentId",
    "kind",
    "identity",
    "issuer",
    "trustPolicy",
    "evidence",
    "observedAt"
  ],
  "type": "object"
}
