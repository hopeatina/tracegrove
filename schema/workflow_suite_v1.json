{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "cases": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "caseRef": {
            "maxLength": 400,
            "minLength": 1,
            "pattern": "^\\.\\/",
            "type": "string"
          },
          "profiles": {
            "anyOf": [
              {
                "items": {
                  "maxLength": 200,
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
                  "type": "string"
                },
                "maxItems": 32,
                "type": "array"
              },
              {
                "type": "null"
              }
            ]
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": [
          "caseRef",
          "required",
          "profiles"
        ],
        "type": "object"
      },
      "maxItems": 500,
      "minItems": 1,
      "type": "array"
    },
    "id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
      "type": "string"
    },
    "schemaVersion": {
      "const": "workflow.suite/v1",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "cases"
  ],
  "type": "object"
}
