{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "coordinationScopeId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "environmentRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "additionalProperties": false,
          "properties": {
            "algorithm": {
              "const": "sha256",
              "type": "string"
            },
            "hex": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "algorithm",
            "hex"
          ],
          "type": "object"
        },
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
          "type": "string"
        },
        "revision": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "revision",
        "digest"
      ],
      "type": "object"
    },
    "maxConcurrent": {
      "maximum": 1000,
      "minimum": 1,
      "type": "integer"
    },
    "maxLeaseMs": {
      "exclusiveMinimum": 0,
      "maximum": 300000,
      "type": "integer"
    },
    "maxPerWorker": {
      "maximum": 1000,
      "minimum": 1,
      "type": "integer"
    },
    "memberIds": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
        "type": "string"
      },
      "maxItems": 1000,
      "minItems": 1,
      "type": "array"
    },
    "personaRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "additionalProperties": false,
          "properties": {
            "algorithm": {
              "const": "sha256",
              "type": "string"
            },
            "hex": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "algorithm",
            "hex"
          ],
          "type": "object"
        },
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
          "type": "string"
        },
        "revision": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "revision",
        "digest"
      ],
      "type": "object"
    },
    "ref": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "additionalProperties": false,
          "properties": {
            "algorithm": {
              "const": "sha256",
              "type": "string"
            },
            "hex": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "algorithm",
            "hex"
          ],
          "type": "object"
        },
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
          "type": "string"
        },
        "revision": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "revision",
        "digest"
      ],
      "type": "object"
    },
    "reservationCeilingCents": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "schemaVersion": {
      "const": "workflow.persona-pool/v1",
      "type": "string"
    },
    "scope": {
      "additionalProperties": false,
      "properties": {
        "ownerId": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
          "type": "string"
        },
        "tenantId": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "visibility": {
          "enum": [
            "public",
            "owner_private",
            "tenant_private"
          ],
          "type": "string"
        }
      },
      "required": [
        "ownerId",
        "tenantId",
        "visibility"
      ],
      "type": "object"
    },
    "selection": {
      "const": "least_used_available",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "ref",
    "scope",
    "coordinationScopeId",
    "personaRef",
    "environmentRef",
    "memberIds",
    "maxConcurrent",
    "maxPerWorker",
    "maxLeaseMs",
    "reservationCeilingCents",
    "selection"
  ],
  "type": "object"
}
