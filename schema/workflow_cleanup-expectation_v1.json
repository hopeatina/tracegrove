{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attemptId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "coordinationVersion": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "effectIds": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 1000,
      "type": "array"
    },
    "generation": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "ownershipLedgerHeadDigest": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
    },
    "resources": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "boundaryId": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "check": {
            "enum": [
              "http_absence",
              "host_stop"
            ],
            "type": "string"
          },
          "entityKey": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "physicalId": {
            "maxLength": 2048,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "entityKey",
          "physicalId",
          "boundaryId",
          "check"
        ],
        "type": "object"
      },
      "maxItems": 1000,
      "type": "array"
    },
    "schemaVersion": {
      "const": "workflow.cleanup-expectation/v1",
      "type": "string"
    },
    "scopeId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "unresolvedEffectIds": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 1000,
      "type": "array"
    },
    "workerId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "scopeId",
    "attemptId",
    "workerId",
    "generation",
    "coordinationVersion",
    "effectIds",
    "unresolvedEffectIds",
    "ownershipLedgerHeadDigest",
    "resources"
  ],
  "type": "object"
}
