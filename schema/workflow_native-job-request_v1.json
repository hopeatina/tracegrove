{
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "maxLength": 64000,
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "items": {
            "$ref": "#/$defs/__schema0"
          },
          "maxItems": 5000,
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          },
          "propertyNames": {
            "maxLength": 200,
            "type": "string"
          },
          "type": "object"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "command": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "submit",
              "type": "string"
            },
            "payload": {
              "$ref": "#/$defs/__schema0"
            },
            "queue": {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
              "type": "string"
            },
            "requestKey": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "action",
            "queue",
            "requestKey",
            "payload"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "read",
              "type": "string"
            },
            "jobId": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "queue": {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
              "type": "string"
            }
          },
          "required": [
            "action",
            "queue",
            "jobId"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "cancel",
              "type": "string"
            },
            "jobId": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "queue": {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
              "type": "string"
            }
          },
          "required": [
            "action",
            "queue",
            "jobId"
          ],
          "type": "object"
        }
      ]
    },
    "credential": {
      "anyOf": [
        {
          "maxLength": 4096,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "id": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
    },
    "kind": {
      "const": "tracegrove.job.request",
      "type": "string"
    }
  },
  "required": [
    "kind",
    "id",
    "credential",
    "command"
  ],
  "type": "object"
}
