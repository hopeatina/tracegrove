{
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "maxLength": 64000,
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "items": {
            "$ref": "#/$defs/__schema0"
          },
          "maxItems": 5000,
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          },
          "propertyNames": {
            "maxLength": 200,
            "type": "string"
          },
          "type": "object"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action": {
      "enum": [
        "submit",
        "read",
        "cancel"
      ],
      "type": "string"
    },
    "attempts": {
      "maximum": 2147483647,
      "minimum": 0,
      "type": "integer"
    },
    "durationMs": {
      "maximum": 2147483647,
      "minimum": 0,
      "type": "integer"
    },
    "jobId": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "kind": {
      "const": "native_job",
      "type": "string"
    },
    "output": {
      "$ref": "#/$defs/__schema0"
    },
    "queue": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
      "type": "string"
    },
    "requestKey": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "cancel_requested",
        "cancelled",
        "missing",
        "forbidden",
        "conflict"
      ],
      "type": "string"
    },
    "workerId": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "jobId",
    "status",
    "requestKey",
    "output",
    "workerId",
    "kind",
    "queue",
    "action",
    "durationMs",
    "attempts"
  ],
  "type": "object"
}
