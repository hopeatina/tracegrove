{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "budgetReservationRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "additionalProperties": false,
          "properties": {
            "algorithm": {
              "const": "sha256",
              "type": "string"
            },
            "hex": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "algorithm",
            "hex"
          ],
          "type": "object"
        },
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
          "type": "string"
        },
        "revision": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "revision",
        "digest"
      ],
      "type": "object"
    },
    "candidates": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "eligible": {
            "type": "boolean"
          },
          "modelId": {
            "maxLength": 400,
            "minLength": 1,
            "type": "string"
          },
          "providerRoute": {
            "maxLength": 400,
            "minLength": 1,
            "type": "string"
          },
          "reasonCodes": {
            "items": {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
              "type": "string"
            },
            "maxItems": 16,
            "type": "array"
          }
        },
        "required": [
          "modelId",
          "providerRoute",
          "eligible",
          "reasonCodes"
        ],
        "type": "object"
      },
      "maxItems": 64,
      "type": "array"
    },
    "catalogRef": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "digest": {
              "additionalProperties": false,
              "properties": {
                "algorithm": {
                  "const": "sha256",
                  "type": "string"
                },
                "hex": {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                }
              },
              "required": [
                "algorithm",
                "hex"
              ],
              "type": "object"
            },
            "id": {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
              "type": "string"
            },
            "revision": {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
              "type": "string"
            }
          },
          "required": [
            "id",
            "revision",
            "digest"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "decidedAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
    },
    "escalationReason": {
      "anyOf": [
        {
          "maxLength": 4000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "estimate": {
      "additionalProperties": false,
      "properties": {
        "amountCents": {
          "anyOf": [
            {
              "maximum": 1000000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "unknownReason": {
          "anyOf": [
            {
              "maxLength": 4000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "amountCents",
        "unknownReason"
      ],
      "type": "object"
    },
    "inputDigest": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "sha256",
          "type": "string"
        },
        "hex": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "algorithm",
        "hex"
      ],
      "type": "object"
    },
    "intelligencePolicyRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "additionalProperties": false,
          "properties": {
            "algorithm": {
              "const": "sha256",
              "type": "string"
            },
            "hex": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "algorithm",
            "hex"
          ],
          "type": "object"
        },
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
          "type": "string"
        },
        "revision": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "revision",
        "digest"
      ],
      "type": "object"
    },
    "owner": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "jobId": {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
              "type": "string"
            },
            "kind": {
              "const": "authoring_job",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "jobId"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "attemptId": {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
              "type": "string"
            },
            "campaignId": {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
              "type": "string"
            },
            "executionId": {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
              "type": "string"
            },
            "kind": {
              "const": "attempt",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "campaignId",
            "executionId",
            "attemptId"
          ],
          "type": "object"
        }
      ]
    },
    "ref": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "additionalProperties": false,
          "properties": {
            "algorithm": {
              "const": "sha256",
              "type": "string"
            },
            "hex": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "algorithm",
            "hex"
          ],
          "type": "object"
        },
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
          "type": "string"
        },
        "revision": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "revision",
        "digest"
      ],
      "type": "object"
    },
    "schemaVersion": {
      "const": "workflow.routing-decision/v1",
      "type": "string"
    },
    "scope": {
      "additionalProperties": false,
      "properties": {
        "ownerId": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
          "type": "string"
        },
        "tenantId": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "visibility": {
          "enum": [
            "public",
            "owner_private",
            "tenant_private"
          ],
          "type": "string"
        }
      },
      "required": [
        "ownerId",
        "tenantId",
        "visibility"
      ],
      "type": "object"
    },
    "selected": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "contextBand": {
              "maxLength": 400,
              "minLength": 1,
              "type": "string"
            },
            "effort": {
              "anyOf": [
                {
                  "maxLength": 400,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "modelId": {
              "maxLength": 400,
              "minLength": 1,
              "type": "string"
            },
            "providerRoute": {
              "maxLength": 400,
              "minLength": 1,
              "type": "string"
            },
            "snapshotId": {
              "anyOf": [
                {
                  "maxLength": 400,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "tools": {
              "items": {
                "maxLength": 200,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
                "type": "string"
              },
              "maxItems": 32,
              "type": "array"
            }
          },
          "required": [
            "modelId",
            "providerRoute",
            "snapshotId",
            "effort",
            "tools",
            "contextBand"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "stage": {
      "enum": [
        "analysis",
        "drafting",
        "discovery",
        "diagnosis",
        "evaluation",
        "benchmark",
        "replay"
      ],
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "ref",
    "scope",
    "owner",
    "stage",
    "inputDigest",
    "intelligencePolicyRef",
    "catalogRef",
    "candidates",
    "selected",
    "estimate",
    "budgetReservationRef",
    "escalationReason",
    "decidedAt"
  ],
  "type": "object"
}
