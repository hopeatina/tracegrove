{
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "maxLength": 64000,
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "items": {
            "$ref": "#/$defs/__schema0"
          },
          "maxItems": 5000,
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          },
          "propertyNames": {
            "maxLength": 200,
            "type": "string"
          },
          "type": "object"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attempts": {
      "const": 1,
      "type": "number"
    },
    "content": {
      "items": {
        "$ref": "#/$defs/__schema0"
      },
      "maxItems": 128,
      "type": "array"
    },
    "durationMs": {
      "maximum": 2147483647,
      "minimum": 0,
      "type": "integer"
    },
    "endpoint": {
      "maxLength": 512,
      "minLength": 1,
      "pattern": "^\\/(?!\\/)[A-Za-z0-9_./-]*$",
      "type": "string"
    },
    "isError": {
      "type": "boolean"
    },
    "kind": {
      "const": "mcp_tool",
      "type": "string"
    },
    "protocolVersion": {
      "maxLength": 32,
      "minLength": 1,
      "type": "string"
    },
    "server": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "type": "object"
    },
    "structuredContent": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema0"
        },
        {
          "type": "null"
        }
      ]
    },
    "tool": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.-]+$",
      "type": "string"
    }
  },
  "required": [
    "kind",
    "endpoint",
    "tool",
    "protocolVersion",
    "server",
    "isError",
    "content",
    "structuredContent",
    "durationMs",
    "attempts"
  ],
  "type": "object"
}
