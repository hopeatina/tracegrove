{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "activationDecisionRef": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "digest": {
              "additionalProperties": false,
              "properties": {
                "algorithm": {
                  "const": "sha256",
                  "type": "string"
                },
                "hex": {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                }
              },
              "required": [
                "algorithm",
                "hex"
              ],
              "type": "object"
            },
            "id": {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
              "type": "string"
            },
            "revision": {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
              "type": "string"
            }
          },
          "required": [
            "id",
            "revision",
            "digest"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "aggregateVersion": {
      "maximum": 2147483647,
      "minimum": 1,
      "type": "integer"
    },
    "definitionRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "additionalProperties": false,
          "properties": {
            "algorithm": {
              "const": "sha256",
              "type": "string"
            },
            "hex": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "algorithm",
            "hex"
          ],
          "type": "object"
        },
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
          "type": "string"
        },
        "revision": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "revision",
        "digest"
      ],
      "type": "object"
    },
    "id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
      "type": "string"
    },
    "invalidationEpoch": {
      "maximum": 2147483647,
      "minimum": 0,
      "type": "integer"
    },
    "latestRoundSequence": {
      "maximum": 2147483647,
      "minimum": 0,
      "type": "integer"
    },
    "qualificationRoundRefs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "digest": {
            "additionalProperties": false,
            "properties": {
              "algorithm": {
                "const": "sha256",
                "type": "string"
              },
              "hex": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              }
            },
            "required": [
              "algorithm",
              "hex"
            ],
            "type": "object"
          },
          "id": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
            "type": "string"
          },
          "revision": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
            "type": "string"
          }
        },
        "required": [
          "id",
          "revision",
          "digest"
        ],
        "type": "object"
      },
      "maxItems": 500,
      "type": "array"
    },
    "scope": {
      "additionalProperties": false,
      "properties": {
        "ownerId": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
          "type": "string"
        },
        "tenantId": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "visibility": {
          "enum": [
            "public",
            "owner_private",
            "tenant_private"
          ],
          "type": "string"
        }
      },
      "required": [
        "ownerId",
        "tenantId",
        "visibility"
      ],
      "type": "object"
    },
    "state": {
      "enum": [
        "proposed",
        "validating",
        "active",
        "degraded",
        "retired"
      ],
      "type": "string"
    }
  },
  "required": [
    "id",
    "scope",
    "aggregateVersion",
    "definitionRef",
    "state",
    "invalidationEpoch",
    "latestRoundSequence",
    "qualificationRoundRefs",
    "activationDecisionRef"
  ],
  "type": "object"
}
